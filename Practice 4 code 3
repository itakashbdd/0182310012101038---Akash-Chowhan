import 'dart:io';

void main() {
  print("Enter expenses separated by space:");

  String input = stdin.readLineSync()!;

  List<double> expenses =
      input.split(" ").map((e) => double.parse(e)).toList();

  double total = 0;

  for (var expense in expenses) {
    total += expense;
  }

  print("Total expense = $total");
}
